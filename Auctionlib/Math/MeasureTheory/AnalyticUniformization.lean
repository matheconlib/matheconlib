/-!
# Jankov–von Neumann uniformization of analytic relations

An analytic relation `R ⊆ X × A` between Polish spaces with nonempty `x`-sections admits a
*uniformization*: a section function `σ : X → A` with `(x, σ x) ∈ R` for every `x`, measurable with
respect to the σ-algebra generated by the analytic subsets of `X`. Combined with Luzin's theorem
that analytic sets are universally measurable
(`Auctionlib/Math/MeasureTheory/AnalyticNullMeasurable.lean`), this yields the measurable-selection
corollaries in `Auctionlib/Math/MeasureTheory/VonNeumannSelection.lean`.

## Main definitions

* `MeasureTheory.listCylinder`: The clopen cylinder of a finite prefix in Baire space.
* `MeasureTheory.leftmostPrefix` / `MeasureTheory.leftmostBranch`: The leftmost branch of a set in
  Baire space and its finite prefixes.

## Main statements

* `MeasureTheory.leftmostBranch_mem`: The leftmost branch of a closed nonempty set belongs to it.
* `MeasureTheory.AnalyticSet.exists_uniformization`: **Jankov–von Neumann uniformization** — an
  analytic relation with nonempty sections has a uniformizing section measurable with respect to
  the σ-algebra generated by analytic sets.
* `MeasureTheory.MeasurableSet.exists_uniformization`: The Borel-relation special case.

## References

* Kechris, A. S. 1995. *Classical Descriptive Set Theory*. Springer-Verlag. Theorem 18.1.

## Tags

uniformization, von neumann selection, analytic set, descriptive set theory, leftmost branch
-/

@[expose] public noncomputable section

open Set

namespace MeasureTheory

/-! ## Finite-prefix cylinders in Baire space -/

/-- The **cylinder** of a finite prefix `t : List ℕ` in Baire space: all `β : ℕ → ℕ` whose first
`t.length` values agree with `t`. -/
def listCylinder (t : List ℕ) : Set (ℕ → ℕ) :=
  {β | ∀ k < t.length, β k = t.getD k 0}

/-- Membership in a list cylinder. -/
@[simp] lemma mem_listCylinder {t : List ℕ} {β : ℕ → ℕ} :
    β ∈ listCylinder t ↔ ∀ k < t.length, β k = t.getD k 0 := Iff.rfl

/-- The cylinder of the empty prefix is all of Baire space. -/
@[simp] lemma listCylinder_nil : listCylinder [] = univ := by
  ext β
  simp [listCylinder]

/-- Extending the prefix by one value cuts the cylinder by one coordinate constraint. -/
lemma listCylinder_append_singleton (t : List ℕ) (m : ℕ) :
    listCylinder (t ++ [m]) = listCylinder t ∩ {β | β t.length = m} := by
  ext β
  simp only [mem_listCylinder, List.length_append, List.length_singleton, mem_inter_iff,
    mem_setOf_eq]
  constructor
  · intro h
    refine ⟨fun k hk => ?_, ?_⟩
    · rw [h k (by omega), List.getD_append _ _ _ _ hk]
    · have hval := h t.length (by omega)
      rwa [List.getD_append_right _ _ _ _ (le_refl _), Nat.sub_self] at hval
  · rintro ⟨hpre, hlast⟩ k hk
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk' | hk'
    · rw [hpre k hk', List.getD_append _ _ _ _ hk']
    · subst hk'
      rw [List.getD_append_right _ _ _ _ (le_refl _), Nat.sub_self, hlast]
      rfl

/-- Every finite-prefix cylinder is closed in Baire space. -/
lemma isClosed_listCylinder (t : List ℕ) : IsClosed (listCylinder t) := by
  have hrw : listCylinder t =
      ⋂ k, ⋂ (_ : k < t.length), (fun β : ℕ → ℕ => β k) ⁻¹' {t.getD k 0} := by
    ext β
    simp [listCylinder]
  rw [hrw]
  exact isClosed_iInter fun k => isClosed_iInter fun _ =>
    IsClosed.preimage (continuous_apply k) isClosed_singleton

/-! ## The leftmost branch of a set in Baire space -/

variable {K : Set (ℕ → ℕ)}

/-- The first `n` values of the **leftmost branch** of `K`, as a list: At each step, extend the
current prefix `t` by the least value `m` such that `K` still meets the cylinder of `t ++ [m]`. -/
def leftmostPrefix (K : Set (ℕ → ℕ)) : ℕ → List ℕ
  | 0 => []
  | n + 1 =>
    let t := leftmostPrefix K n
    t ++ [sInf {m | (K ∩ listCylinder (t ++ [m])).Nonempty}]

/-- The **leftmost branch** of `K`, choosing at each step the least next coordinate whose cylinder
meets `K`. For closed nonempty `K`, the branch belongs to `K`. -/
def leftmostBranch (K : Set (ℕ → ℕ)) : ℕ → ℕ :=
  fun n => (leftmostPrefix K (n + 1)).getD n 0

/-- The `n`-th prefix has length `n`. -/
@[simp] lemma leftmostPrefix_length (n : ℕ) : (leftmostPrefix K n).length = n := by
  induction n with
  | zero => rfl
  | succ n ih => simp [leftmostPrefix, List.length_append, ih]

/-- The prefixes are nested: A shorter prefix is a list-prefix of a longer one. -/
lemma leftmostPrefix_prefix {m n : ℕ} (hmn : m ≤ n) :
    leftmostPrefix K m <+: leftmostPrefix K n := by
  induction n with
  | zero => rw [Nat.le_zero.mp hmn]
  | succ n ih =>
    rcases Nat.lt_succ_iff_lt_or_eq.mp (Nat.lt_succ_of_le hmn) with hlt | heq
    · exact (ih (Nat.lt_succ_iff.mp hlt)).trans ⟨_, rfl⟩
    · rw [heq]

/-- For `k < n`, the `k`-th coordinate of the branch equals the corresponding entry of its `n`-th
prefix. -/
lemma leftmostBranch_eq_getD {k n : ℕ} (hkn : k < n) :
    leftmostBranch K k = (leftmostPrefix K n).getD k 0 := by
  have hpre : leftmostPrefix K (k + 1) <+: leftmostPrefix K n := leftmostPrefix_prefix hkn
  have hk_lt_k1 : k < (leftmostPrefix K (k + 1)).length := by
    rw [leftmostPrefix_length]
    omega
  have hk_lt_n : k < (leftmostPrefix K n).length := by
    rw [leftmostPrefix_length]
    exact hkn
  have hget : (leftmostPrefix K (k + 1))[k] = (leftmostPrefix K n)[k] :=
    List.IsPrefix.getElem hpre hk_lt_k1
  rw [leftmostBranch, List.getD_eq_getElem _ _ hk_lt_k1, List.getD_eq_getElem _ _ hk_lt_n, hget]

/-- The branch extends each of its prefixes. -/
lemma leftmostBranch_mem_listCylinder (n : ℕ) :
    leftmostBranch K ∈ listCylinder (leftmostPrefix K n) := by
  rw [mem_listCylinder]
  intro k hk
  rw [leftmostPrefix_length] at hk
  exact leftmostBranch_eq_getD hk

/-- A nonempty set meets the cylinder of every prefix of its leftmost branch. -/
lemma nonempty_inter_listCylinder_leftmostPrefix (hne : K.Nonempty) (n : ℕ) :
    (K ∩ listCylinder (leftmostPrefix K n)).Nonempty := by
  induction n with
  | zero => simpa [leftmostPrefix] using hne
  | succ n ih =>
    set t := leftmostPrefix K n with ht
    set S := {m | (K ∩ listCylinder (t ++ [m])).Nonempty} with hS
    obtain ⟨β, hβK, hβcyl⟩ := ih
    have hβS : β t.length ∈ S :=
      ⟨β, hβK, by rw [listCylinder_append_singleton]; exact ⟨hβcyl, rfl⟩⟩
    simpa [leftmostPrefix, ← ht, ← hS] using Nat.sInf_mem ⟨β t.length, hβS⟩

/-- The `(n + 1)`-st prefix is `t ++ [m]` exactly when the `n`-th prefix is `t`, the set meets the
`t ++ [m]` cylinder, and it misses the `t ++ [j]` cylinders for all `j < m`. -/
lemma leftmostPrefix_succ_eq_append_iff (hne : K.Nonempty) {n : ℕ} {t : List ℕ}
    (ht : t.length = n) {m : ℕ} :
    leftmostPrefix K (n + 1) = t ++ [m] ↔
      leftmostPrefix K n = t ∧ (K ∩ listCylinder (t ++ [m])).Nonempty ∧
        ∀ j < m, K ∩ listCylinder (t ++ [j]) = ∅ := by
  set t' := leftmostPrefix K n with ht'
  set S' := {m' | (K ∩ listCylinder (t' ++ [m'])).Nonempty} with hS'
  have hstep : leftmostPrefix K (n + 1) = t' ++ [sInf S'] := rfl
  have hlen' : t'.length = t.length := by rw [ht', leftmostPrefix_length, ht]
  have hS'ne : S'.Nonempty := by
    obtain ⟨β, hβK, hβcyl⟩ := nonempty_inter_listCylinder_leftmostPrefix hne n
    exact ⟨β t'.length, β, hβK, by rw [listCylinder_append_singleton]; exact ⟨hβcyl, rfl⟩⟩
  rw [hstep]
  constructor
  · intro h
    obtain ⟨ht'eq, hmeq⟩ := List.append_inj h (by rw [hlen'])
    have hsInf_eq : sInf S' = m := by simpa using List.head_eq_of_cons_eq hmeq
    subst ht'eq
    refine ⟨rfl, ?_, ?_⟩
    · have hsInf_mem : sInf S' ∈ S' := Nat.sInf_mem hS'ne
      rw [hsInf_eq] at hsInf_mem
      exact hsInf_mem
    · intro j hj
      have hjnot : j ∉ S' := Nat.notMem_of_lt_sInf (by rw [hsInf_eq]; exact hj)
      rw [hS', mem_setOf_eq, Set.not_nonempty_iff_eq_empty] at hjnot
      exact hjnot
  · rintro ⟨ht'eq, hmem, hbelow⟩
    subst ht'eq
    have hmem' : m ∈ S' := hmem
    have hsInf_eq : sInf S' = m := by
      refine le_antisymm (Nat.sInf_le hmem') ?_
      by_contra hlt
      push Not at hlt
      have hbad : K ∩ listCylinder (t' ++ [sInf S']) = ∅ := hbelow _ hlt
      have hgood : sInf S' ∈ S' := Nat.sInf_mem hS'ne
      rw [hS', mem_setOf_eq, hbad] at hgood
      exact hgood.ne_empty rfl
    rw [hsInf_eq]

/-- The leftmost branch of a closed nonempty set belongs to it. -/
theorem leftmostBranch_mem (hK : IsClosed K) (hne : K.Nonempty) : leftmostBranch K ∈ K := by
  choose β hβ using fun n => nonempty_inter_listCylinder_leftmostPrefix hne n
  have hβK : ∀ n, β n ∈ K := fun n => (hβ n).1
  have hβcyl : ∀ n, β n ∈ listCylinder (leftmostPrefix K n) := fun n => (hβ n).2
  -- Each `β n` agrees with the branch on the first `n` coordinates, so `β` converges to the branch.
  have htendsto : Filter.Tendsto β Filter.atTop (nhds (leftmostBranch K)) := by
    rw [tendsto_pi_nhds]
    intro k
    refine Filter.Tendsto.congr' ?_ tendsto_const_nhds
    filter_upwards [Filter.eventually_gt_atTop k] with n hn
    have hk_lt_n : k < (leftmostPrefix K n).length := by
      rw [leftmostPrefix_length]
      exact hn
    rw [(mem_listCylinder.mp (hβcyl n)) k hk_lt_n, ← leftmostBranch_eq_getD hn]
  exact hK.mem_of_tendsto htendsto (Filter.Eventually.of_forall hβK)

/-! ## Jankov–von Neumann uniformization -/

/-- **Jankov–von Neumann uniformization** (Kechris 1995, Theorem 18.1): An analytic relation
between Polish spaces with nonempty sections admits a uniformizing function measurable with respect
to the σ-algebra generated by analytic sets. -/
theorem AnalyticSet.exists_uniformization
    {X A : Type*}
    [TopologicalSpace X] [PolishSpace X] [MeasurableSpace X] [BorelSpace X]
    [TopologicalSpace A] [PolishSpace A] [MeasurableSpace A] [BorelSpace A]
    {R : Set (X × A)} (hR : AnalyticSet R)
    (hsec : ∀ x, (Prod.mk x ⁻¹' R).Nonempty) :
    ∃ σ : X → A, (∀ x, (x, σ x) ∈ R) ∧
      Measurable[MeasurableSpace.generateFrom {S : Set X | AnalyticSet S}] σ := by
  rcases isEmpty_or_nonempty X with hX | hX
  · exact ⟨fun x => isEmptyElim x, fun x => isEmptyElim x,
      fun s _ => by simp [Set.eq_empty_of_isEmpty]⟩
  rw [AnalyticSet] at hR
  rcases hR with hR_empty | ⟨f, hf_cont, hf_range⟩
  · obtain ⟨a, ha⟩ := hsec (Classical.arbitrary X)
    rw [hR_empty] at ha
    exact absurd ha (Set.notMem_empty _)
  set π : (ℕ → ℕ) → X := fun β => (f β).1 with hπ
  have hπ_cont : Continuous π := continuous_fst.comp hf_cont
  set K : X → Set (ℕ → ℕ) := fun x => π ⁻¹' {x} with hKdef
  have hK_closed : ∀ x, IsClosed (K x) := fun x => isClosed_singleton.preimage hπ_cont
  have hK_ne : ∀ x, (K x).Nonempty := by
    intro x
    obtain ⟨a, ha⟩ := hsec x
    rw [show R = range f from hf_range.symm] at ha
    obtain ⟨β, hβ⟩ := ha
    exact ⟨β, by simp [hKdef, hπ, hβ]⟩
  set L : X → (ℕ → ℕ) := fun x => leftmostBranch (K x) with hLdef
  have hL_mem : ∀ x, π (L x) = x := fun x => leftmostBranch_mem (hK_closed x) (hK_ne x)
  refine ⟨fun x => (f (L x)).2, fun x => ?_, ?_⟩
  · have hfx : f (L x) ∈ R := by
      rw [show R = range f from hf_range.symm]
      exact Set.mem_range_self _
    have hpair : (x, (f (L x)).2) = f (L x) := Prod.ext (hL_mem x).symm rfl
    rw [hpair]
    exact hfx
  · -- The cylinder-contact sets `D t` are analytic; prefix events of the leftmost branch
    -- are Boolean combinations of the `D t`, giving `𝔄`-measurability.
    set 𝔄 : MeasurableSpace X := MeasurableSpace.generateFrom {S : Set X | AnalyticSet S}
      with h𝔄
    set D : List ℕ → Set X := fun t => {x | (K x ∩ listCylinder t).Nonempty} with hDdef
    have hD_meas : ∀ t, MeasurableSet[𝔄] (D t) := by
      intro t
      refine MeasurableSpace.measurableSet_generateFrom ?_
      have hD_eq_image : D t = π '' listCylinder t := by
        ext x
        simp only [hDdef, Set.mem_setOf_eq, Set.mem_image]
        constructor
        · rintro ⟨β, hβK, hβcyl⟩
          exact ⟨β, hβcyl, hβK⟩
        · rintro ⟨β, hβcyl, hβx⟩
          exact ⟨β, hβx, hβcyl⟩
      rw [Set.mem_setOf_eq, hD_eq_image]
      exact ((isClosed_listCylinder t).analyticSet).image_of_continuous hπ_cont
    have hE_meas : ∀ (n : ℕ) (t : List ℕ),
        MeasurableSet[𝔄] {x | leftmostPrefix (K x) n = t} := by
      intro n
      induction n with
      | zero =>
        intro t
        rcases eq_or_ne t [] with rfl | ht
        · have huniv : {x : X | leftmostPrefix (K x) 0 = []} = Set.univ := by
            ext x
            simp [leftmostPrefix]
          rw [huniv]
          exact MeasurableSet.univ
        · have hempty : {x : X | leftmostPrefix (K x) 0 = t} = ∅ := by
            ext x
            simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
            intro h
            rw [show leftmostPrefix (K x) 0 = [] from rfl] at h
            exact ht h.symm
          rw [hempty]
          exact MeasurableSet.empty
      | succ n ih =>
        intro t
        by_cases hlen : t.length = n + 1
        · have htne : t ≠ [] := by
            intro h
            rw [h] at hlen
            exact Nat.succ_ne_zero n hlen.symm
          obtain ⟨t', m, rfl⟩ : ∃ (t' : List ℕ) (m : ℕ), t = t' ++ [m] :=
            ⟨t.dropLast, t.getLast htne, (List.dropLast_append_getLast htne).symm⟩
          have ht' : t'.length = n := by
            rw [List.length_append, List.length_singleton] at hlen
            omega
          have hsplit : {x : X | leftmostPrefix (K x) (n + 1) = t' ++ [m]} =
              {x | leftmostPrefix (K x) n = t'} ∩ D (t' ++ [m]) ∩
                ⋂ (j : ℕ) (_ : j < m), (D (t' ++ [j]))ᶜ := by
            ext x
            rw [Set.mem_setOf_eq, leftmostPrefix_succ_eq_append_iff (hK_ne x) ht']
            simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_iInter, Set.mem_compl_iff,
              hDdef, and_assoc]
            refine and_congr_right fun _ => and_congr_right fun _ => ?_
            constructor
            · intro h j hj
              rw [h j hj]
              exact fun hcontra => hcontra.ne_empty rfl
            · intro h j hj
              exact Set.not_nonempty_iff_eq_empty.mp (h j hj)
          rw [hsplit]
          exact ((ih t').inter (hD_meas _)).inter
            (MeasurableSet.iInter fun j => MeasurableSet.iInter fun _ => (hD_meas _).compl)
        · have hempty : {x : X | leftmostPrefix (K x) (n + 1) = t} = ∅ := by
            ext x
            simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
            intro h
            exact hlen (h ▸ leftmostPrefix_length (n + 1))
          rw [hempty]
          exact MeasurableSet.empty
    have hcoord : ∀ n : ℕ, Measurable[𝔄] fun x => L x n := by
      intro n
      refine measurable_to_countable' fun m => ?_
      have hunion : (fun x => L x n) ⁻¹' {m} =
          ⋃ (t : List ℕ) (_ : t.getD n 0 = m), {x | leftmostPrefix (K x) (n + 1) = t} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_setOf_eq]
        constructor
        · intro h
          exact ⟨leftmostPrefix (K x) (n + 1), h, rfl⟩
        · rintro ⟨t, hgetD, hprefix⟩
          rw [hLdef]
          simp only [leftmostBranch, hprefix, hgetD]
      rw [hunion]
      exact MeasurableSet.iUnion fun t => MeasurableSet.iUnion fun _ => hE_meas (n + 1) t
    have hL_meas : Measurable[𝔄] L := measurable_pi_iff.mpr hcoord
    have hf_meas : Measurable fun β : ℕ → ℕ => (f β).2 :=
      (continuous_snd.comp hf_cont).measurable
    exact hf_meas.comp hL_meas

/-- A Borel relation between Polish spaces with nonempty sections admits a uniformizing function
measurable with respect to the σ-algebra generated by analytic sets. -/
theorem MeasurableSet.exists_uniformization
    {X A : Type*}
    [TopologicalSpace X] [PolishSpace X] [MeasurableSpace X] [BorelSpace X]
    [TopologicalSpace A] [PolishSpace A] [MeasurableSpace A] [BorelSpace A]
    {R : Set (X × A)} (hR : MeasurableSet R)
    (hsec : ∀ x, (Prod.mk x ⁻¹' R).Nonempty) :
    ∃ σ : X → A, (∀ x, (x, σ x) ∈ R) ∧
      Measurable[MeasurableSpace.generateFrom {S : Set X | AnalyticSet S}] σ :=
  hR.analyticSet.exists_uniformization hsec

end MeasureTheory

