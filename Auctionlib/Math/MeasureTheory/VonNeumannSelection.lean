module

public import Auctionlib.Math.MeasureTheory.AnalyticNullMeasurable
public import Auctionlib.Math.MeasureTheory.AnalyticUniformization

/-!
# Von Neumann measurable selection

A measurable relation between standard Borel spaces with nonempty sections admits a `Measurable`
selection whose graph lies in the relation almost everywhere, with respect to any finite measure on
the source. As an economic selection principle, a jointly measurable payoff that strictly beats a
measurable threshold somewhere on a positive-measure set of states has a single measurable
improving choice that beats the threshold on a positive-measure set.

An analytic uniformization is measurable with respect to the σ-algebra generated by analytic sets.
Its Borel-measurable representative may lose the graph property on a null set. The results here
assume a finite measure on the source.

## Main statements

* `MeasureTheory.MeasurableSet.exists_measurable_selection_ae`: Measurable selection from a
  section-nonempty measurable relation, a.e. form.
* `MeasureTheory.exists_measurable_improving_selection`: Measurable choice of a strictly improving
  action on a positive-measure set.

## Tags

measurable selection, von neumann, uniformization, standard borel, improving deviation
-/

@[expose] public noncomputable section

open Set

namespace MeasureTheory

variable {X A : Type*} [MeasurableSpace X] [StandardBorelSpace X]
  [MeasurableSpace A] [StandardBorelSpace A] [Nonempty A]

omit [Nonempty A] in
/-- **Von Neumann measurable selection, a.e. form.** A measurable relation `R ⊆ X × A` between
standard Borel spaces, all of whose `x`-sections are nonempty, admits a `Measurable` selection
whose graph lies in `R` almost everywhere with respect to any finite measure on `X`.

The selection may depend on `μ`: the everywhere-uniformizing section from
`AnalyticSet.exists_uniformization` is only measurable for the σ-algebra generated by analytic
sets, and the passage to a Borel-measurable representative may break the graph property on a
`μ`-null set. -/
theorem MeasurableSet.exists_measurable_selection_ae
    {R : Set (X × A)} (μ : Measure X) [IsFiniteMeasure μ]
    (hR : MeasurableSet R) (hsec : ∀ x, (Prod.mk x ⁻¹' R).Nonempty) :
    ∃ σ : X → A, Measurable σ ∧ ∀ᵐ x ∂μ, (x, σ x) ∈ R := by
  letI := upgradeStandardBorel X
  letI := upgradeStandardBorel A
  obtain ⟨σ₀, hσ₀_graph, hσ₀_meas⟩ := MeasurableSet.exists_uniformization hR hsec
  have hσ₀_nullMeasurable : NullMeasurable σ₀ μ :=
    nullMeasurable_of_measurable_generateFrom_analyticSet μ hσ₀_meas
  have hσ₀_aemeasurable : AEMeasurable σ₀ μ := hσ₀_nullMeasurable.aemeasurable
  refine ⟨hσ₀_aemeasurable.mk σ₀, hσ₀_aemeasurable.measurable_mk, ?_⟩
  filter_upwards [hσ₀_aemeasurable.ae_eq_mk] with x hx
  rw [← hx]
  exact hσ₀_graph x

/-- **Measurable improving selection.** If a jointly measurable payoff strictly beats a measurable
threshold for some action on a set of positive measure, then a measurable action choice beats that
threshold on a set of positive measure. -/
theorem exists_measurable_improving_selection
    {f : X → A → ℝ} (hf : Measurable (Function.uncurry f))
    {g : X → ℝ} (hg : Measurable g)
    (μ : Measure X) [IsFiniteMeasure μ]
    (hpos : 0 < μ {x | ∃ a, g x < f x a}) :
    ∃ σ : X → A, Measurable σ ∧ 0 < μ {x | g x < f x (σ x)} := by
  have hR_meas : MeasurableSet {p : X × A | g p.1 < f p.1 p.2} :=
    measurableSet_lt (hg.comp measurable_fst) hf
  -- The improving set `S` is the projection of a Borel set, hence analytic and null-measurable.
  have hS_null : NullMeasurableSet {x | ∃ a, g x < f x a} μ := by
    letI := upgradeStandardBorel X
    have hS_eq : {x | ∃ a, g x < f x a} = Prod.fst '' {p : X × A | g p.1 < f p.1 p.2} := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_image, Prod.exists]
      exact ⟨fun ⟨a, ha⟩ => ⟨x, a, ha, rfl⟩, fun ⟨x', a, ha, hx⟩ => ⟨a, hx ▸ ha⟩⟩
    rw [hS_eq]
    exact (hR_meas.analyticSet_image measurable_fst).nullMeasurableSet μ
  obtain ⟨S₀, hS₀_sub, hS₀_meas, hS₀_ae⟩ := hS_null.exists_measurable_subset_ae_eq
  have hS₀_pos : 0 < μ S₀ := by
    rw [measure_congr hS₀_ae]
    exact hpos
  have hR'_meas : MeasurableSet
      ({p : X × A | g p.1 < f p.1 p.2} ∪ S₀ᶜ ×ˢ (Set.univ : Set A)) :=
    hR_meas.union (hS₀_meas.compl.prod MeasurableSet.univ)
  have hR'_sec : ∀ x,
      (Prod.mk x ⁻¹' ({p : X × A | g p.1 < f p.1 p.2} ∪ S₀ᶜ ×ˢ (Set.univ : Set A))).Nonempty := by
    intro x
    by_cases hx : x ∈ S₀
    · obtain ⟨a, ha⟩ := hS₀_sub hx
      exact ⟨a, Set.mem_union_left _ ha⟩
    · exact ⟨Classical.arbitrary A,
        Set.mem_union_right _ (Set.mem_prod.mpr ⟨hx, Set.mem_univ _⟩)⟩
  obtain ⟨σ, hσ_meas, hσ_graph⟩ :=
    MeasurableSet.exists_measurable_selection_ae μ hR'_meas hR'_sec
  refine ⟨σ, hσ_meas, ?_⟩
  -- On `S₀`, membership in the enlarged relation forces the selected action to improve payoff.
  have hsub : ∀ x ∈ S₀,
      (x, σ x) ∈ {p : X × A | g p.1 < f p.1 p.2} ∪ S₀ᶜ ×ˢ (Set.univ : Set A) →
        g x < f x (σ x) := by
    intro x hxS₀ hx_graph
    rcases hx_graph with h | h
    · exact h
    · exact absurd h.1 (by simpa using hxS₀)
  have hbad_null :
      μ {x | (x, σ x) ∉ ({p : X × A | g p.1 < f p.1 p.2} ∪ S₀ᶜ ×ˢ (Set.univ : Set A))} = 0 :=
    ae_iff.mp hσ_graph
  refine hS₀_pos.trans_le ?_
  conv_lhs => rw [← measure_diff_null hbad_null]
  refine measure_mono fun x hx => ?_
  exact hsub x hx.1 (not_not.mp hx.2)

end MeasureTheory

end
