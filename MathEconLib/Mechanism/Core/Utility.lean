module

public import MathEconLib.GameTheory.Strategic.Outcome
public import MathEconLib.Mechanism.Core.Comap

/-!
# Mechanism consequences and supplied utility

A mechanism's consequence consists of its outcome and the entire signed transfer vector.
Supplied utility evaluates that consequence at a fixed true state. The strategic game uses
the shared outcome evaluation; it requires no prior, utility order, or quasilinearity.

Positive transfers remain money received by an agent. Utilities may depend on all transfers;
`utilityFromOwnTransfer` is the function adapter for utilities depending only on one's own receipt.
-/

@[expose] public section

open MathEconLib.GameTheory

namespace MathEconLib.Mechanism

universe uI uA uB uO uS uV

variable {I : Type uI} {A : I → Type uA} {B : I → Type uB}
  {O : Type uO} {S : Type uS} {V : Type uV}

/-- The outcome and full signed transfer vector generated by the mechanism. -/
def toOutcomeGame (M : Mechanism I A O) : OutcomeGame I A (O × (I → ℝ)) where
  outcome a := (M.outcome a, fun i ↦ M.transfer i a)

/-- The consequence retains both the physical outcome and every agent's monetary receipt. -/
@[simp] theorem toOutcomeGame_outcome (M : Mechanism I A O) (a : Profile A) :
    M.toOutcomeGame.outcome a = (M.outcome a, fun i ↦ M.transfer i a) :=
  rfl

/-- Adapt an own-transfer utility function to the full mechanism consequence carrier. -/
def utilityFromOwnTransfer (u : I → S → O → ℝ → V) :
    I → S → (O × (I → ℝ)) → V :=
  fun i s c ↦ u i s c.1 (c.2 i)

/-- The own-transfer adapter selects the evaluated agent's signed monetary receipt. -/
@[simp] theorem utilityFromOwnTransfer_apply (u : I → S → O → ℝ → V)
    (i : I) (s : S) (c : O × (I → ℝ)) :
    utilityFromOwnTransfer u i s c = u i s c.1 (c.2 i) :=
  rfl

/-- Evaluate supplied utility at a fixed true state through the shared outcome-game interface. -/
def toStrategicGame (M : Mechanism I A O) (u : I → S → (O × (I → ℝ)) → V)
    (s : S) : StrategicGame I A V :=
  StrategicGame.ofOutcome M.toOutcomeGame
    (({ payoff := fun i x ↦ u i x.1 x.2 } :
      PayoffStructure I (S × (O × (I → ℝ))) V).atState s)

/-- Strategic payoffs evaluate the mechanism consequence at the supplied true state. -/
@[simp] theorem toStrategicGame_payoff (M : Mechanism I A O)
    (u : I → S → (O × (I → ℝ)) → V) (s : S) (i : I) (a : Profile A) :
    (M.toStrategicGame u s).payoff i a = u i s (M.outcome a, fun j ↦ M.transfer j a) :=
  rfl

/-- Converting reports before evaluation agrees exactly with converting the game's actions. -/
@[simp] theorem toStrategicGame_comap (M : Mechanism I A O)
    (κ : (i : I) → B i → A i) (u : I → S → (O × (I → ℝ)) → V) (s : S) :
    (M.comap κ).toStrategicGame u s = (M.toStrategicGame u s).comapActions κ :=
  rfl

end MathEconLib.Mechanism

end
