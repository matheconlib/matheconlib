{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matheconlib",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "route": {
    "pattern": "mathecon.dev",
    "custom_domain": true
  },
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/docs", "/docs/*"]
  },
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "matheconlib-docs"
    }
  ]
}
